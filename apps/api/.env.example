NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/community"
REDIS_URL="redis://127.0.0.1:6379"
JWT_SECRET="replace-with-a-random-string-at-least-32-chars"
JWT_REFRESH_TTL_DAYS=7
WEB_ORIGIN="https://localhost:5173"
INTERNAL_API_TOKEN="dev-internal-token-change-me"
LOG_LEVEL=info

# Optional: Meilisearch. 留空时搜索接口自动降级为 MySQL LIKE 查询。
MEILI_HOST="http://127.0.0.1:7700"
MEILI_KEY="masterKey"

# Optional: OpenAI 兼容接口。留空时 AI 助手返回本地模拟流。
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"